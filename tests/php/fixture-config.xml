<?xml version="1.0"?>
<opnsense>
  <system><hostname>fw</hostname><domain>lan</domain></system>
  <interfaces>
    <wan><if>vtnet0</if><enable>1</enable><descr>WAN</descr></wan>
    <lan><if>vtnet1</if><enable>1</enable><descr>LAN</descr><ipaddr>192.168.1.1</ipaddr><subnet>24</subnet></lan>
    <opt1><if>wg0</if><enable>1</enable><descr>WG</descr></opt1>
  </interfaces>
  <nat><outbound><mode>automatic</mode></outbound></nat>
  <OPNsense>
    <Firewall>
      <Filter version="1.0.9">
        <rules>
          <rule uuid="11111111-1111-4111-8111-111111111111">
            <enabled>1</enabled><statetype>keep</statetype><sequence>1</sequence><action>pass</action><quick>1</quick>
            <interfacenot>0</interfacenot><interface>lan</interface><direction>in</direction><ipprotocol>inet46</ipprotocol>
            <protocol>any</protocol><source_net>lan</source_net><source_not>0</source_not><destination_net>any</destination_net>
            <destination_not>0</destination_not><description>Default allow LAN to any</description>
          </rule>
          <rule uuid="22222222-2222-4222-8222-222222222222">
            <enabled>1</enabled><statetype>keep</statetype><sequence>5</sequence><action>block</action><quick>1</quick>
            <interfacenot>0</interfacenot><interface>wan</interface><direction>in</direction><ipprotocol>inet</ipprotocol>
            <protocol>any</protocol><source_net>any</source_net><source_not>0</source_not><destination_net>any</destination_net>
            <destination_not>0</destination_not><description>wan block</description>
          </rule>
        </rules>
      </Filter>
      <Alias version="1.0.1"><aliases/></Alias>
    </Firewall>
    <gwswitch version="1.0.0">
      <general><enabled>1</enabled><interfaces>lan</interfaces><wan_interfaces>wan</wan_interfaces><interval>5</interval><kill_states>1</kill_states><skip_rules_gw_down>1</skip_rules_gw_down><log>0</log></general>
      <profiles>
        <profile uuid="aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"><enabled>1</enabled><name>vpn1</name><gateway4>WG_GW</gateway4><gateway6/><ipv6_mode>reject</ipv6_mode><nat>1</nat><description/></profile>
        <profile uuid="bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"><enabled>1</enabled><name>vpn6</name><gateway4>WG_GW</gateway4><gateway6>WG_GW6</gateway6><ipv6_mode>route</ipv6_mode><nat>1</nat><description/></profile>
      </profiles>
      <clients>
        <client uuid="cccccccc-cccc-4ccc-8ccc-cccccccccccc"><enabled>1</enabled><mac>aa:bb:cc:dd:ee:01</mac><profile>aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa</profile><description>laptop</description></client>
        <client uuid="dddddddd-dddd-4ddd-8ddd-dddddddddddd"><enabled>1</enabled><mac>aa:bb:cc:dd:ee:02</mac><profile/><description>tv</description></client>
      </clients>
    </gwswitch>
  </OPNsense>
</opnsense>
